/* ========================= Recursos ========================= */

void PrecacheAndAddToDownloads()
{
    char fullPath[PLATFORM_MAX_PATH];
    for (int i = 0; i < MAX_SOUNDS; i++)
    {
        Format(fullPath, sizeof(fullPath), "sound/%s", g_SoundPaths[i]);
        if (FileExists(fullPath, true))
            AddFileToDownloadsTable(fullPath);
        PrecacheSound(g_SoundPaths[i], true);
    }
}

/* ========================= Eventos y sonidos ========================= */

public Action Event_PlayerJump(Event event, const char[] name, bool dontBroadcast)
{
    if (!gCvarEnable.BoolValue || event == null) return Plugin_Continue;

    int client = GetClientOfUserId(event.GetInt("userid", 0));
    if (!IsValidClient(client) || !IsSurvivor(client)) return Plugin_Continue;

    PlayJumpSound(client);
    TryApplySonicBoostOnJump(client);
    return Plugin_Continue;
}

public Action Cmd_Jump(int client, int args)
{
    if (!gCvarEnable.BoolValue || !IsValidClient(client) || !IsSurvivor(client)) return Plugin_Continue;
    PlayJumpSound(client);
    TryApplySonicBoostOnJump(client);
    return Plugin_Continue;
}

void PlayJumpSound(int client)
{
    int idx = g_iPlayerSoundIdx[client];
    if (!(0 <= idx < MAX_SOUNDS)) return;

    float now = GetEngineTime();
    if (now < g_flNextAllowed[client]) return;

    g_flNextAllowed[client] = now + gCvarCooldown.FloatValue;
    EmitSoundToAll(g_SoundPaths[idx], client, SNDCHAN_AUTO, SNDLEVEL_NORMAL, _, gCvarVolume.FloatValue);
}

void TryApplySonicBoostOnJump(int client)
{
    // Sonic index 0
    if (g_iPlayerCharIdx[client] != 0) return;
    if (!IsClientInGame(client) || IsFakeClient(client) || !IsPlayerAlive(client)) return;

    float vel[3];
    bool gotVel = false;
    PropType propType = Prop_Send;

    if (HasEntProp(client, Prop_Send, "m_vecVelocity"))
    {
        GetEntPropVector(client, Prop_Send, "m_vecVelocity", vel);
        gotVel = true;
        propType = Prop_Send;
    }
    else if (HasEntProp(client, Prop_Data, "m_vecVelocity"))
    {
        GetEntPropVector(client, Prop_Data, "m_vecVelocity", vel);
        gotVel = true;
        propType = Prop_Data;
    }

    if (!gotVel) return;

    float minZ = gCvarVelZMin.FloatValue;
    if (vel[2] >= minZ)
    {
        float mult = gCvarSonicBoost.FloatValue;
        vel[2] *= mult;
        SetEntPropVector(client, propType, "m_vecVelocity", vel);
    }
}

/* ========================= Persistencia de dueños (archivo) ========================= */

bool GetClientSteamID(int client, char steam[64])
{
    if (!IsClientAuthorized(client)) return false;
    return GetClientAuthId(client, AuthId_Steam2, steam, sizeof(steam), true);
}

void CharIdxToKey(int idx, char key[8])
{
    IntToString(idx, key, sizeof(key));
}

bool GetCharOwnerSteam(int idx, char steam[32])
{
    char key[8];
    CharIdxToKey(idx, key);
    return g_mCharOwner.GetString(key, steam, sizeof(steam));
}

void SetCharOwnerSteam(int idx, int client)
{
    char steam[32];
    if (!GetClientSteamID(client, steam)) return;
    char key[8];
    CharIdxToKey(idx, key);
    g_mCharOwner.SetString(key, steam);
}

void RemoveCharOwner(int idx)
{
    char key[8];
    CharIdxToKey(idx, key);
    g_mCharOwner.Remove(key);
}

void ClearAllCharOwners()
{
    delete g_mCharOwner;
    g_mCharOwner = new StringMap();
}

bool IsCharAvailableForClient(int idx, int client)
{
    if (g_iCharTakenBy[idx] != 0 && g_iCharTakenBy[idx] != client) return false;

    char ownerSteam[32], clientSteam[32];
    if (GetCharOwnerSteam(idx, ownerSteam))
    {
        if (!GetClientSteamID(client, clientSteam)) return false;
        if (!StrEqual(ownerSteam, clientSteam)) return false;
    }
    return true;
}

/* ----- Archivo KeyValues para dueños ----- */

void LoadOwnersFromFile()
{
    KeyValues kv = new KeyValues("SonicJumpOwners");
    if (!kv.ImportFromFile(g_sOwnersFile))
    {
        delete kv;
        return;
    }
    ClearAllCharOwners();

    if (kv.GotoFirstSubKey(false))
    {
        do {
            char key[8];
            kv.GetSectionName(key, sizeof(key));
            char steam[32];
            kv.GetString("steam64", steam, sizeof(steam), "");
            if (steam[0]) g_mCharOwner.SetString(key, steam);
        } while (kv.GotoNextKey(false));
    }
    delete kv;
}

void SaveOwnersToFile()
{
    KeyValues kv = new KeyValues("SonicJumpOwners");
    for (int i = 0; i < MAX_CHARS; i++)
    {
        char key[8], steam[32];
        CharIdxToKey(i, key);
        if (g_mCharOwner.GetString(key, steam, sizeof(steam)))
        {
            kv.JumpToKey(key, true);
            kv.SetString("steam64", steam);
            kv.GoBack();
        }
    }
    kv.ExportToFile(g_sOwnersFile);
    delete kv;
}

/* ========================= Ocupación (sesión) ========================= */

bool IsClientAmyAllowed(int client)
{
    return CheckCommandAccess(client, "sj_amy", ADMFLAG_GENERIC, true);
}

void AssignCharacterToClient(int charIdx, int client)
{
    if (!(0 <= charIdx < MAX_CHARS)) return;
    g_iCharTakenBy[charIdx] = client;
}

void RebuildCharOccupancyFromPlayers()
{
    for (int i = 0; i < MAX_CHARS; i++) g_iCharTakenBy[i] = 0;

    for (int client = 1; client <= MaxClients; client++)
    {
        if (!IsValidClient(client)) continue;

        int idx = g_iPlayerCharIdx[client];

        if (!(0 <= idx < MAX_CHARS) && AreClientCookiesCached(client))
        {
            LoadPlayerCharChoice(client);
            idx = g_iPlayerCharIdx[client];
        }
        if (!(0 <= idx < MAX_CHARS)) continue;

        if (idx == AMY_INDEX && !IsClientAmyAllowed(client))
        {
            g_iPlayerCharIdx[client] = INVALID_CHAR_INDEX;
            continue;
        }
        if (IsCharAvailableForClient(idx, client))
        {
            AssignCharacterToClient(idx, client);
            SetCharOwnerSteam(idx, client);
        }
        else
        {
            g_iPlayerCharIdx[client] = INVALID_CHAR_INDEX;
        }
    }
    SaveOwnersToFile();
}

