public void OnPluginStart()
{
    // Cvars principales
    gCvarEnable   = CreateConVar("sj_enable", "1", "Habilita el plugin (1=on, 0=off)", FCVAR_NOTIFY, true, 0.0, true, 1.0);
    gCvarVolume   = CreateConVar("sj_volume", "1.0", "Volumen (0.0-1.0)", FCVAR_NOTIFY, true, 0.0, true, 1.0);
    gCvarCooldown = CreateConVar("sj_cooldown", "0.15", "Cooldown por jugador en segundos.", FCVAR_NOTIFY, true, 0.0, true, 5.0);


    // Cvars Double Jump (Paegus)
    CreateConVar("sm_doublejump_version", "1.0.1", "Double Jump Version", FCVAR_PLUGIN | FCVAR_NOTIFY);
    g_cvJumpEnable = CreateConVar("sm_doublejump_enabled", "1", "Enables double-jumping.", FCVAR_PLUGIN | FCVAR_NOTIFY);
    g_cvJumpBoost  = CreateConVar("sm_doublejump_boost", "250.0", "The amount of vertical boost to apply to double jumps.", FCVAR_PLUGIN | FCVAR_NOTIFY);
    g_cvJumpMax    = CreateConVar("sm_doublejump_max", "1", "The maximum number of re-jumps allowed while already jumping.", FCVAR_PLUGIN | FCVAR_NOTIFY);

    HookConVarChange(g_cvJumpBoost, convar_ChangeBoost);
    HookConVarChange(g_cvJumpEnable, convar_ChangeEnable);
    HookConVarChange(g_cvJumpMax, convar_ChangeMax);

    g_bDoubleJump = GetConVarBool(g_cvJumpEnable);
    g_flBoost     = GetConVarFloat(g_cvJumpBoost);
    g_iJumpMax    = GetConVarInt(g_cvJumpMax);

    // Eventos / comandos
    HookEvent("player_jump", Event_PlayerJump, EventHookMode_Post);
	HookEvent("player_death", Event_PlayerDeath, EventHookMode_Pre);
	HookEvent("round_start", OnRoundStart);
    RegConsoleCmd("+jump", Cmd_Jump);
    RegConsoleCmd("js", Cmd_OpenSoundMenu);
    RegConsoleCmd("sc", Cmd_OpenCharMenu);
    RegConsoleCmd("cinfo", Cmd_ShowCharInfo);
	RegConsoleCmd("superjump", Command_SuperJump, "Salta alto como Sonic!");
	RegConsoleCmd("sm_forceragdoll", Cmd_CreateRagdoll);
	RegConsoleCmd("sm_checkpoint", Cmd_SonicCheckpoint);


    RegAdminCmd("sm_setsound", Cmd_OpenSoundMenu, ADMFLAG_GENERIC, "Abre el menú de selección de sonido de salto.");
    RegAdminCmd("freechars", Cmd_FreeAllChars, ADMFLAG_GENERIC, "Libera todos los personajes bloqueados.");

    // Cookies
    g_hSoundCookie = RegClientCookie("sj_sound_choice", "Sonic Jump sound selection", CookieAccess_Public);
    g_hCharCookie  = RegClientCookie("sj_char_choice", "Sonic character selection", CookieAccess_Public);

    // Estado inicial ocupación
    for (int i = 0; i < MAX_CHARS; i++) g_iCharTakenBy[i] = 0;

    // Dueños persistentes
    g_mCharOwner = new StringMap();
    BuildPath(Path_SM, g_sOwnersFile, sizeof(g_sOwnersFile), "data/sonic_jump_survivors_owners.cfg");
    LoadOwnersFromFile();
	Speed_OnPluginStart();
    Sally_OnPluginStart();

    AutoExecConfig(true, "sonic_jump_survivors");

    for (int i = 1; i <= MaxClients; i++)
    {
        if (IsClientInGame(i))
        {
            if (AreClientCookiesCached(i))
            {
                LoadPlayerSoundChoice(i);
                LoadPlayerCharChoice(i);
                MaybePromptMenus(i);
            }
        }
    }
}

