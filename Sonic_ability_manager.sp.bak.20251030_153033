/* ========================= NUEVO LOOP DOUBLE JUMP =========================
   Basado en Paegus. Solo se aplica si:
   - Plugin habilitado
   - Cliente válido, vivo, superviviente
   - Personaje actual es Amy
   - sm_doublejump_enabled = 1
   ======================================================================= */

public void OnGameFrame()
{
    if (!gCvarEnable.BoolValue) return;
    if (!g_bDoubleJump) return;
	//Sonic_OnGameFrame();
    for (int i = 1; i <= MaxClients; i++)
    {
        if (!IsValidClient(i)) continue;
        if (!IsPlayerAlive(i)) continue;
        if (!IsSurvivor(i)) continue;

        // Solo Amy
        if (g_iPlayerCharIdx[i] != AMY_INDEX) continue;

        DoubleJump_Check(i);
    }
}

stock void DoubleJump_Check(int client)
{
    int fCurFlags = GetEntityFlags(client);
    int fCurButtons = GetClientButtons(client);

    if (g_fLastFlags[client] & FL_ONGROUND)
    {
        // estaba en suelo el frame pasado
        if (!(fCurFlags & FL_ONGROUND) && !(g_fLastButtons[client] & IN_JUMP) && (fCurButtons & IN_JUMP))
        {
            OriginalJump(client);
        }
    }
    else if (fCurFlags & FL_ONGROUND)
    {
        // aterrizó
        Landed(client);
    }
    else if (!(g_fLastButtons[client] & IN_JUMP) && (fCurButtons & IN_JUMP))
    {
        ReJump(client);
    }

    g_fLastFlags[client] = fCurFlags;
    g_fLastButtons[client] = fCurButtons;
}

stock void OriginalJump(int client)
{
    g_iJumps[client]++;
}

stock void Landed(int client)
{
    g_iJumps[client] = 0;
}

stock void ReJump(int client)
{
    if (g_iJumps[client] >= 1 && g_iJumps[client] <= g_iJumpMax)
    {
        g_iJumps[client]++;

        float vVel[3];
        GetEntPropVector(client, Prop_Data, "m_vecVelocity", vVel);
        vVel[2] = g_flBoost;

        TeleportEntity(client, NULL_VECTOR, NULL_VECTOR, vVel);

        // Opcional: reproducir sonido de salto si está configurado
        PlayJumpSound(client);
    }
}

