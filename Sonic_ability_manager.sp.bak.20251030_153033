public void SetCharacterForClient(int client, int newIndex)
{
    g_iPlayerCharIdx[client] = newIndex;

    // Quita hooks antiguos
    SDKUnhook(client, SDKHook_OnTakeDamage, Sonic_OnTakeDamage_Fall);

    // Si ahora es Sonic, vuelve a enganchar
    if (newIndex == SONIC_INDEX)
    {
        SDKHook(client, SDKHook_OnTakeDamage, Sonic_OnTakeDamage_Fall);
    }
}

// Crea el ragdoll del jugador sin matarlo realmente
// =====================
//  Crear Ragdoll del jugador
// =====================
public void CreateSonicRagdoll(int client)
{
    if (!IsClientInGame(client) || !IsPlayerAlive(client))
        return;

    float pos[3], ang[3], vel[3];
    GetClientAbsOrigin(client, pos);
    GetClientAbsAngles(client, ang);
    GetEntPropVector(client, Prop_Data, "m_vecVelocity", vel);

    char model[PLATFORM_MAX_PATH];
    GetClientModel(client, model, sizeof(model));

    // Crear entidad física (prop_ragdoll)
    int ent = CreateEntityByName("prop_ragdoll");
    if (ent == -1)
    {
        PrintToChat(client, "[Sonic] ❌ No se pudo crear ragdoll.");
        return;
    }

    DispatchKeyValue(ent, "model", model);
    DispatchKeyValue(ent, "spawnflags", "4"); // 4 = Debe colisionar
    DispatchKeyValue(ent, "body", "0");
    DispatchKeyValue(ent, "skin", "0");

    DispatchSpawn(ent);
    TeleportEntity(ent, pos, ang, vel);

    SetEntityRenderColor(ent, 255, 255, 255, 255);
    SetEntityMoveType(ent, MOVETYPE_VPHYSICS);
    SetEntPropEnt(ent, Prop_Send, "m_hOwnerEntity", client);

    PrintToChat(client, "[Sonic] 💀 Se ha generado tu ragdoll!");
}