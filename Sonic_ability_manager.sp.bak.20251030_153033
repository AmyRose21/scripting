void LoadPlayerSoundChoice(int client)
{
    if (!IsValidClient(client)) return;
    char buf[8];
    GetClientCookie(client, g_hSoundCookie, buf, sizeof(buf));
    if (!buf[0]) return;
    int idx = StringToInt(buf);
    g_iPlayerSoundIdx[client] = (0 <= idx < MAX_SOUNDS) ? idx : INVALID_SOUND_INDEX;
}

void LoadPlayerCharChoice(int client)
{
    if (!IsValidClient(client)) return;
    char buf[8];
    GetClientCookie(client, g_hCharCookie, buf, sizeof(buf));
    if (!buf[0]) return;

    int idx = StringToInt(buf);
    if (!(0 <= idx < MAX_CHARS))
    {
        g_iPlayerCharIdx[client] = INVALID_CHAR_INDEX;
        return;
    }

    if (idx == AMY_INDEX && !IsClientAmyAllowed(client))
    {
        g_iPlayerCharIdx[client] = INVALID_CHAR_INDEX;
        SetClientCookie(client, g_hCharCookie, "");
        PrintToChat(client, "[SonicJump] Amy es exclusiva para administradores.");
        return;
    }

    if (!IsCharAvailableForClient(idx, client))
    {
        g_iPlayerCharIdx[client] = INVALID_CHAR_INDEX;
        PrintToChat(client, "[SonicJump] Tu personaje guardado (%s) no está disponible.", g_CharNames[idx]);
        return;
    }

    AssignCharacterToClient(idx, client);
    g_iPlayerCharIdx[client] = idx;
    SetCharOwnerSteam(idx, client);
    SaveOwnersToFile();
}

