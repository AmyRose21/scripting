    gCvarDuration   = CreateConVar("sm_fireshield_duration", "20.0", "Duración del escudo (s).", FCVAR_NOTIFY);
    gCvarCooldown   = CreateConVar("sm_fireshield_cooldown", "35.0", "Enfriamiento (s).", FCVAR_NOTIFY);
    gCvarOnlyHuman  = CreateConVar("sm_fireshield_onlyhuman", "1", "Solo jugadores humanos pueden usarlo.", FCVAR_NOTIFY);

    // Escudo burbuja
    gCvarBubbleEnable       = CreateConVar("sm_bubbleshield_enable", "1", "Habilita el escudo burbuja.", FCVAR_NOTIFY);
    gCvarBubbleDuration     = CreateConVar("sm_bubbleshield_duration", "10.0", "Duración del escudo burbuja (s).", FCVAR_NOTIFY);
    gCvarBubbleCooldown     = CreateConVar("sm_bubbleshield_cooldown", "20.0", "Enfriamiento (s).", FCVAR_NOTIFY);
