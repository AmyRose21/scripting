    HookEvent("player_disconnect", E_PlayerReset, EventHookMode_Post);

    CreateTimer(0.05, T_ShieldThink, _, TIMER_REPEAT | TIMER_FLAG_NO_MAPCHANGE);
	AutoExecConfig(true, "escudo_Elementales_Sally");
	ResetAllShields(true);
}

// ======== Chat comandos ========
public Action ChatCommandListener(int client, const char[] command, int argc)
{
    if (client <= 0 || !IsClientInGame(client)) return Plugin_Continue;

    char msg[192];
    GetCmdArgString(msg, sizeof(msg));
    StripQuotes(msg);
    for (int i = 0; msg[i] != '\0'; i++)
        msg[i] = CharToLower(msg[i]);

    if (StrEqual(msg, "!fire", false) || StrEqual(msg, "/fire", false))
    {
        Cmd_ToggleShield(client, 0);
        return Plugin_Handled;
    }

    if (StrEqual(msg, "!bubble", false) || StrEqual(msg, "/bubble", false))
    {
        Cmd_ToggleBubble(client, 0);
        return Plugin_Handled;
    }

    return Plugin_Continue;
}

// ======== Escudo de fuego ========
public Action Cmd_ToggleShield(int client, int args)
{
    if (!gCvarEnable.BoolValue || !IsValidSurvivor(client))
        return Plugin_Handled;

    if (gCvarOnlyHuman.BoolValue && IsFakeClient(client))
    {
        PrintToChat(client, "[Escudo] Solo jugadores humanos.");
        return Plugin_Handled;
    }

    float now = GetEngineTime();

    if (g_bShieldActive[client])
    {
        g_bShieldActive[client] = false;
        EffectStop(client);
        PrintToChat(client, "[Escudo] Desactivado.");
        return Plugin_Handled;
    }

    if (now < g_fShieldNextUse[client])
    {
        float wait = g_fShieldNextUse[client] - now;
        PrintToChat(client, "[Escudo] Enfriamiento: %.1f s", wait);
        return Plugin_Handled;
    }

    g_bShieldActive[client] = true;
    g_fShieldEndTime[client] = now + gCvarDuration.FloatValue;
    g_fShieldNextTick[client] = 0.0;
    g_fShieldNextUse[client] = now + gCvarCooldown.FloatValue + gCvarDuration.FloatValue;

    EffectStart(client);
    PrintToChat(client, "[Escudo] Activado por %.1f s. Radio %.0f.", gCvarDuration.FloatValue, gCvarRadius.FloatValue);
    return Plugin_Handled;
}

public Action T_ShieldThink(Handle timer)
{
    if (!g_bMapActive || (!gCvarEnable.BoolValue && !gCvarBubbleEnable.BoolValue))
        return Plugin_Continue;

    float now = GetEngineTime();

    // ======== Escudo de fuego ========
    for (int i = 1; i <= MaxClients; i++)
    {
        if (!g_bShieldActive[i]) continue;

        if (!IsClientInGame(i) || !IsPlayerAlive(i) || GetClientTeam(i) != 2)
        {
            StopShield(i);
            continue;
        }

        if (now >= g_fShieldEndTime[i])
        {
            StopShield(i);
            continue;
        }

        if (now < g_fShieldNextTick[i]) continue;
        g_fShieldNextTick[i] = now + gCvarTick.FloatValue;
        ApplyShieldPulse(i);
    }

    // ======== Flotación del escudo burbuja ========
    for (int i = 1; i <= MaxClients; i++)
    {
        if (!g_bBubbleActive[i]) continue;
        if (!IsClientInGame(i) || !IsPlayerAlive(i) || GetClientTeam(i) != 2) continue;

        int waterLevel = GetEntProp(i, Prop_Send, "m_nWaterLevel");
        if (waterLevel < 3) continue; // solo si está completamente sumergido

        int buttons = GetClientButtons(i);
        if (!(buttons & IN_JUMP)) continue;

        float vel[3];
        GetEntPropVector(i, Prop_Data, "m_vecVelocity", vel);

        if (vel[2] < 200.0)
        {
            vel[2] += 40.0; // fuerza de flotación por tick
            TeleportEntity(i, NULL_VECTOR, NULL_VECTOR, vel);
        }
    }

    return Plugin_Continue;
}


void StopShield(int client)
{
    if (!g_bShieldActive[client]) return;
    g_bShieldActive[client] = false;
    g_fShieldNextUse[client] = GetEngineTime() + gCvarCooldown.FloatValue;
    EffectStop(client);
    if (IsClientInGame(client)) PrintToChat(client, "[Escudo] Finalizado. Enfriamiento %.1f s.", gCvarCooldown.FloatValue);
}

void ApplyShieldPulse(int owner)
{
    float origin[3];
    GetClientAbsOrigin(owner, origin);

    float radius = gCvarRadius.FloatValue;
    float dps = gCvarDPS.FloatValue;
    float tick = gCvarTick.FloatValue;
    float damage = dps * tick;
    float push = gCvarPushForce.FloatValue;
    float ignite = gCvarIgniteTime.FloatValue;

    int entity = -1;
    while ((entity = FindEntityByClassname(entity, "infected")) != -1)
        ProcessEntity(owner, entity, origin, radius, damage, push, ignite);

    entity = -1;
    while ((entity = FindEntityByClassname(entity, "player")) != -1)
    {
        if (!IsClientInGame(entity) || !IsPlayerAlive(entity)) continue;
        if (GetClientTeam(entity) != 3) continue;
        ProcessEntity(owner, entity, origin, radius, damage, push, ignite);
    }

    TE_SetupBeamRingPoint(origin, 10.0, radius, PrecacheModel("materials/sprites/laserbeam.vmt"), 0, 0, 0, 0.2, 4.0, 2.0, {255, 120, 20, 100}, 0, 0);
    TE_SendToAll();
}

void ProcessEntity(int owner, int ent, const float origin[3], float radius, float damage, float push, float ignite)
{
    float pos[3];
    GetEntPropVector(ent, Prop_Send, "m_vecOrigin", pos);

    float dist = GetVectorDistance(origin, pos, true);
    float r2 = radius * radius;
    if (dist > r2) return;

    float dir[3];
    MakeVectorFromPoints(origin, pos, dir);
    NormalizeVector(dir, dir);

    float vel[3];
    vel[0] = dir[0];
    vel[1] = dir[1];
    vel[2] = dir[2];
    ScaleVector(vel, push);
    ForcePushEntity(ent, origin, push);

    SDKHooks_TakeDamage(ent, owner, owner, damage, DMG_BURN | DMG_PREVENT_PHYSICS_FORCE);
    IgniteEntity(ent, ignite);

    if (IsClient(ent) && GetClientTeam(ent) == 3)
        L4D_StaggerPlayer(ent, owner, origin);
}


void ForcePushEntity(int ent, const float origin[3], float push)
{
    if (!IsValidEntity(ent)) return;

    float pos[3], dir[3];
    GetEntPropVector(ent, Prop_Send, "m_vecOrigin", pos);

    MakeVectorFromPoints(origin, pos, dir);
    NormalizeVector(dir, dir);

    // --- 1️⃣ Impulso vertical inmediato para despegar del suelo ---
    float lift[3];
    lift[0] = pos[0];
    lift[1] = pos[1];
    lift[2] = pos[2] + 10.0; // Más alto para garantizar separación del suelo

    TeleportEntity(ent, lift, NULL_VECTOR, NULL_VECTOR);

    // --- 2️⃣ Esperamos un tick (0.01s) y aplicamos el empuje ---
    DataPack pack;
    CreateDataTimer(0.01, Timer_ApplyRepel, pack);
    pack.WriteCell(EntIndexToEntRef(ent));
    pack.WriteFloatArray(origin, 3);
    pack.WriteFloat(push);
}

public Action Timer_ApplyRepel(Handle timer, DataPack pack)
{
    pack.Reset();
    int ref = pack.ReadCell();
    int ent = EntRefToEntIndex(ref);
    if (ent <= 0 || !IsValidEntity(ent))
        return Plugin_Stop;

    float origin[3];
    pack.ReadFloatArray(origin, 3);
    float push = pack.ReadFloat();

    float pos[3], dir[3], vel[3];
    GetEntPropVector(ent, Prop_Send, "m_vecOrigin", pos);
    MakeVectorFromPoints(origin, pos, dir);
    NormalizeVector(dir, dir);

    // --- 2️⃣ Repel horizontal ---
    dir[2] += 0.25; // Pequeño componente vertical
    ScaleVector(dir, push);
    vel[0] = dir[0];
    vel[1] = dir[1];
    vel[2] = dir[2];

    TeleportEntity(ent, NULL_VECTOR, NULL_VECTOR, vel);
    SetEntPropVector(ent, Prop_Data, "m_vecVelocity", vel);

    // --- Stagger para especiales ---
    if (IsClient(ent) && GetClientTeam(ent) == 3)
    {
        L4D_StaggerPlayer(ent, ent, origin);
    }

    // --- 3️⃣ Refuerzo opcional ---
    CreateTimer(0.01, Timer_RePush, EntIndexToEntRef(ent));

    return Plugin_Stop;
}



public Action Timer_RePush(Handle timer, int ref)
{
    int ent = EntRefToEntIndex(ref);
    if (ent <= 0 || !IsValidEntity(ent))
        return Plugin_Stop;

    float vel[3];
    GetEntPropVector(ent, Prop_Data, "m_vecVelocity", vel);
    vel[2] += 2.0; // impulso vertical final
    SetEntPropVector(ent, Prop_Data, "m_vecVelocity", vel);

    return Plugin_Stop;
}



// ======== Escudo burbuja ========
public Action Cmd_ToggleBubble(int client, int args)
{
    if (!gCvarBubbleEnable.BoolValue || !IsValidSurvivor(client))
        return Plugin_Handled;

    float now = GetEngineTime();

    if (g_bBubbleActive[client])
    {
        g_bBubbleActive[client] = false;
        EffectBubbleStop(client);
        PrintToChat(client, "[Burbuja] Escudo burbuja desactivado.");
        return Plugin_Handled;
    }

    if (now < g_fBubbleNextUse[client])
    {
        float wait = g_fBubbleNextUse[client] - now;
        PrintToChat(client, "[Burbuja] Espera %.1f s antes de volver a usar.", wait);
        return Plugin_Handled;
    }

    g_bBubbleActive[client] = true;
    g_fBubbleEndTime[client] = now + gCvarBubbleDuration.FloatValue;
    g_fBubbleNextUse[client] = now + gCvarBubbleDuration.FloatValue + gCvarBubbleCooldown.FloatValue;

    EffectBubbleStart(client);
    PrintToChat(client, "[Burbuja] Escudo burbuja activo por %.1f s.", gCvarBubbleDuration.FloatValue);
    CreateTimer(gCvarBubbleDuration.FloatValue, Timer_StopBubble, GetClientUserId(client), TIMER_FLAG_NO_MAPCHANGE);

    return Plugin_Handled;
}

public Action Timer_StopBubble(Handle timer, any userid)
{
    int client = GetClientOfUserId(userid);
    if (client && g_bBubbleActive[client])
    {
        g_bBubbleActive[client] = false;
        EffectBubbleStop(client);
        PrintToChat(client, "[Burbuja] Escudo finalizado.");
    }
    return Plugin_Stop;
}

// ======== Hook de daño ========
public Action OnTakeDamage(int victim, int &attacker, int &inflictor, float &damage, int &damagetype)
{
    if (!IsClientInGame(victim) || !IsPlayerAlive(victim)) return Plugin_Continue;
    if (!g_bBubbleActive[victim]) return Plugin_Continue;

    if (gCvarBubbleAbsorb.BoolValue)
    {
        float heal = damage * gCvarBubbleHealFactor.FloatValue;
        int hp = GetClientHealth(victim);
        SetEntityHealth(victim, hp + RoundToNearest(heal));
        damage = 0.0;
    }

if (IsClientInGame(attacker) && attacker != victim)
{
    float vPos[3];
    GetClientAbsOrigin(victim, vPos);
    ForcePushEntity(attacker, vPos, gCvarBubbleReflectForce.FloatValue);
	EmitSoundToAll("mobius/sfx/shield_element/Sally_Acorn_water_shield_rebote.mp3", victim);
}


    return Plugin_Changed;
}

