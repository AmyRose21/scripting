    gCvarBubbleAbsorb       = CreateConVar("sm_bubbleshield_absorb", "1", "1 = Absorbe todo el daño, 0 = Parcial.", FCVAR_NOTIFY);

    AddCommandListener(ChatCommandListener, "say");
    AddCommandListener(ChatCommandListener, "say_team");
