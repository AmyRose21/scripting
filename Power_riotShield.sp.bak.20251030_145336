void StopSoundToAll(int channel, const char[] sound)
{
    for (int i = 1; i <= MaxClients; i++)
    {
        if (IsClientInGame(i) && !IsFakeClient(i))
        {
            StopSound(i, channel, sound);
        }
    }
}




// ======== Efectos globales (audibles para todos) ========
void EffectStart(int client)
{
    EmitSoundToAll("mobius/sfx/shield_element/Sally_Acorn_fire_shield.mp3", client);
}

void EffectStop(int client)
{
    StopSoundToAll(SNDCHAN_AUTO, "mobius/sfx/shield_element/Sally_Acorn_fire_shield.mp3");
    EmitSoundToAll("mobius/sfx/shield_element/Fire_shield_stop.mp3", client);
}

void EffectBubbleStart(int client)
{
    EmitSoundToAll("mobius/sfx/shield_element/Sally_Acorn_water_shield.mp3", client);
    PrintCenterText(client, "🛡 ¡Escudo burbuja activado!");
}

void EffectBubbleStop(int client)
{
    StopSoundToAll(SNDCHAN_AUTO, "mobius/sfx/shield_element/Sally_Acorn_water_shield.mp3");
    EmitSoundToAll("mobius/sfx/shield_element/Sally_Acorn_water_shield_over.mp3", client);
    PrintCenterText(client, "💥 Escudo burbuja disipado.");
}



// ======== Utilidades ========
bool IsValidSurvivor(int client) { return (1 <= client <= MaxClients) && IsClientInGame(client) && IsPlayerAlive(client) && GetClientTeam(client) == 2; }
bool IsClient(int ent) { return (1 <= ent <= MaxClients); }

public void E_PlayerReset(Event event, const char[] name, bool dontBroadcast)
{
    int userid = event.GetInt("userid");
    int client = GetClientOfUserId(userid);
    if (client > 0 && client <= MaxClients)
        ResetShieldState(client, true);
}

public void OnClientPutInServer(int client)
{
    SDKHook(client, SDKHook_OnTakeDamage, OnTakeDamage);
    ResetShieldState(client, false);
}

public void OnClientDisconnect(int client)
{
    ResetShieldState(client, true);
}

public void OnMapStart()
{
    g_bMapActive = false;

    PrecacheModel("materials/sprites/laserbeam.vmt", true);
    PrecacheSound("mobius/sfx/shield_element/Sally_Acorn_fire_shield.mp3", true);
    PrecacheSound("mobius/sfx/shield_element/Fire_shield_stop.mp3", true);
    PrecacheSound("mobius/sfx/shield_element/Sally_Acorn_water_shield.mp3", true);
    PrecacheSound("mobius/sfx/shield_element/Sally_Acorn_water_shield_over.mp3", true);
    PrecacheSound("mobius/sfx/shield_element/Sally_Acorn_water_shield_rebote.mp3", true);
	
    ResetAllShields(true);

    for (int i = 1; i <= MaxClients; i++)
        ResetShieldState(i, false);

    if (g_hThinkTimer != INVALID_HANDLE)
    {
        CloseHandle(g_hThinkTimer);
        g_hThinkTimer = INVALID_HANDLE;
    }
    g_hThinkTimer = CreateTimer(0.05, T_ShieldThink, _, TIMER_REPEAT | TIMER_FLAG_NO_MAPCHANGE);
    g_bMapActive = true;
}

public void OnMapEnd()
{
    g_bMapActive = false;

    // Detener efectos visuales/sonoros y limpiar flags
    for (int i = 1; i <= MaxClients; i++)
    {
        if (g_bShieldActive[i])
            EffectStop(i);
        if (g_bBubbleActive[i])
            EffectBubbleStop(i);

        g_bShieldActive[i] = false;
        g_bBubbleActive[i] = false;
    }

    if (g_hThinkTimer != INVALID_HANDLE)
    {
        CloseHandle(g_hThinkTimer);
        g_hThinkTimer = INVALID_HANDLE;
    }
}


