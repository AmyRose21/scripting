// ======== Funciones base ========
void ResetShieldState(int client, bool fullCooldown = false)
{
    if (client < 1 || client > MaxClients) return;

    if (g_bShieldActive[client])
        EffectStop(client);

    g_bShieldActive[client]   = false;
    g_bBubbleActive[client]   = false;
    g_fShieldEndTime[client]  = 0.0;
    g_fShieldNextTick[client] = 0.0;
    g_fBubbleEndTime[client]  = 0.0;

    g_fShieldNextUse[client]  = fullCooldown ? (GetEngineTime() + gCvarCooldown.FloatValue) : 0.0;
    g_fBubbleNextUse[client]  = fullCooldown ? (GetEngineTime() + gCvarBubbleCooldown.FloatValue) : 0.0;
}

void ResetAllShields(bool fullCooldown = false)
{
    for (int i = 1; i <= MaxClients; i++)
    {
        if (!IsClientInGame(i))
            continue;

        ResetShieldState(i, fullCooldown);

        // Volver a aplicar hook de daño si es necesario
        SDKUnhook(i, SDKHook_OnTakeDamage, OnTakeDamage);
        SDKHook(i, SDKHook_OnTakeDamage, OnTakeDamage);
    }

    // Cancelar el timer de control si existía
    if (g_hThinkTimer != INVALID_HANDLE)
    {
        CloseHandle(g_hThinkTimer);
        g_hThinkTimer = INVALID_HANDLE;
    }

    // Reiniciar el timer principal
    g_hThinkTimer = CreateTimer(0.05, T_ShieldThink, _, TIMER_REPEAT | TIMER_FLAG_NO_MAPCHANGE);
}


