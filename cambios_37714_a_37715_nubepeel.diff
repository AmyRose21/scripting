+// v6.22: el POLVO GRIS de la CARGA — port del sonic_peeloutdust2_OM
+// (L795-807: en cada paso de la animacion de carga, 45 smokegrenades
+// grises detras). Aqui: misma bateria con tinte (180,180,180) a los
+// pies detras, gate 0.2s (la carga dura sonicom_peel_charge s).
+void Sonic_PeelChargeDust(int client, float now)
+{
+    if (g_cvSonicTrails == null || !g_cvSonicTrails.BoolValue) return;
+    if (now < g_fSonicPeelDustNext[client]) return;
+    g_fSonicPeelDustNext[client] = now + 0.2;
+    if (!IsClientInGame(client) || !IsPlayerAlive(client)) return;
+
+    float pos[3];
+    GetClientAbsOrigin(client, pos);
+    float ang[3];
+    GetClientAbsAngles(client, ang);
+    float rad = ang[1] * FLOAT_PI / 180.0;
+    float fwd[3];
+    fwd[0] = Cosine(rad);
+    fwd[1] = Sine(rad);
+    fwd[2] = 0.0;
+
+    bool smokeOK = (g_bSonicFxMatSmoke && g_iSonicFxMatSmoke > 0);
+    for (int i = 0; i < 3; i++)
+    {
+        float p[3];
+        p[0] = pos[0] - fwd[0] * 15.0 + GetRandomFloat(-12.0, 12.0);
+        p[1] = pos[1] - fwd[1] * 15.0 + GetRandomFloat(-12.0, 12.0);
+        p[2] = pos[2] + 6.0 + GetRandomFloat(0.0, 14.0);
+        Sonic_SpawnPeelPuff(p, smokeOK ? SONIC_FX_MAT_SMOKE : SONIC_SPRITE_GLOW,
+                            smokeOK ? GetRandomFloat(0.07, 0.15) : GetRandomFloat(0.18, 0.30),
+                            "180 180 180", 115, GetRandomFloat(1.2, 1.7), smokeOK ? 0 : 5);
+    }
+}
