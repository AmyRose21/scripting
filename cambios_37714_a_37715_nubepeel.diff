+// v6.22: la NUBE de la CARRERA (pealoutEffectcd2 cada 0.1s en GMod).
+// La llama la FSM case 2 (corriendo) — ya corre a 10 Hz.
+void Sonic_PeelCloudTick(int client)
+{
+    if (g_cvSonicTrails == null || !g_cvSonicTrails.BoolValue) return;
+    if (!IsClientInGame(client) || !IsPlayerAlive(client)) return;
+
+    float pos[3];
+    GetClientAbsOrigin(client, pos);
+
+    // forward horizontal del player (patron yaw del encadenado de pies)
+    float ang[3];
+    GetClientAbsAngles(client, ang);
+    float rad = ang[1] * FLOAT_PI / 180.0;
+    float fwd[3];
+    fwd[0] = Cosine(rad);
+    fwd[1] = Sine(rad);
+    fwd[2] = 0.0;
+
+    // emitter base: pos + 27z + fwd*10 (L1608/1648: +Vector(0,0,27)+fwd*10)
+    float base[3];
+    base[0] = pos[0] + fwd[0] * 10.0;
+    base[1] = pos[1] + fwd[1] * 10.0;
+    base[2] = pos[2] + 27.0;
+
+    bool smokeOK = (g_bSonicFxMatSmoke && g_iSonicFxMatSmoke > 0);
+
+    // 3 HUMOS AZULES (Color(135,185,255), 20-25 -> 0 alla)
+    for (int i = 0; i < 3; i++)
+    {
+        float p[3];
+        p[0] = base[0] + GetRandomFloat(-22.0, 22.0);
+        p[1] = base[1] + GetRandomFloat(-22.0, 22.0);
+        p[2] = base[2] + GetRandomFloat(-16.0, 20.0);
+        Sonic_SpawnPeelPuff(p, smokeOK ? SONIC_FX_MAT_SMOKE : SONIC_SPRITE_GLOW,
+                            smokeOK ? GetRandomFloat(0.16, 0.28) : GetRandomFloat(0.30, 0.45),
+                            "135 185 255", smokeOK ? 120 : 80,
+                            GetRandomFloat(0.35, 0.55), smokeOK ? 0 : 5);
+    }
+
+    // 2 GLOWS (light_glow02_add Color(125,125,175), 45-55 -> 0 alla)
+    for (int i = 0; i < 2; i++)
+    {
+        float p[3];
+        p[0] = base[0] + GetRandomFloat(-28.0, 28.0);
+        p[1] = base[1] + GetRandomFloat(-28.0, 28.0);
+        p[2] = base[2] + GetRandomFloat(-14.0, 24.0);
+        Sonic_SpawnPeelPuff(p, SONIC_SPRITE_GLOW, GetRandomFloat(0.60, 0.85),
+                            "125 125 175", 100, GetRandomFloat(0.35, 0.55), 5);
+    }
+
+    // 1 MOON (sonic_peelout_moons: puppet+35z, sonic_dashing_effect
+    // 16->112 — sprite estatico de 40-90u si el material esta)
+    if (g_bSonicFxMatMoon && g_iSonicFxMatMoon > 0)
+    {
+        float p[3];
+        p[0] = base[0] + GetRandomFloat(-14.0, 14.0);
+        p[1] = base[1] + GetRandomFloat(-14.0, 14.0);
+        p[2] = pos[2] + 35.0 + GetRandomFloat(-8.0, 8.0);
+        Sonic_SpawnPeelPuff(p, SONIC_FX_MAT_MOON, GetRandomFloat(0.08, 0.18),
+                            "255 255 255", 235, 0.45, 5);
+    }
+}
